{
  "name": "vsa-app",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:ios": "expo export --platform ios --output-dir dist",
    "bench:replay": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bench-replay.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:release": "npm run typecheck && npm run lint && npm test && npm run check:ios && npm run verify:native",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@react-native-ai/apple": "^0.12.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  }
}
